# ─── Core Django ───────────────────────────────────────────────────────────
# In production DEBUG must be False. SECRET_KEY is REQUIRED in production;
# generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
DEBUG=False
SECRET_KEY=replace-with-a-long-random-value

# Comma separated hostnames that may serve this app.
ALLOWED_HOSTS=api.example.com,127.0.0.1,localhost

# ─── LLM provider (fallback values; editable later from the admin panel) ──
LLM_API_KEY=your-llm-api-key
LLM_BASE_URL=https://api.gapgpt.app/v1
LLM_MODEL=deepseek-v4-pro
LLM_MAX_TOKENS=700
LLM_TIMEOUT_SECONDS=30
# Keep 0 for predictable interactive latency; the widget retries on timeout.
LLM_MAX_RETRIES=0

# ─── Embedding provider (fallback values; editable from the admin panel) ──
EMBEDDING_API_KEY=your-embedding-api-key
EMBEDDING_BASE_URL=https://api.gapgpt.app/v1
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_TIMEOUT_SECONDS=15
EMBEDDING_MAX_RETRIES=0

# ─── Widget installation / access control ─────────────────────────────────
# These two values are only the FALLBACK. The same settings can be managed
# per customer from the admin panel (AI provider settings → نصب ویجت و
# کنترل دسترسی), which also applies them to CORS — so new customers can be
# onboarded without touching the server. Leave them empty and use the panel.
#
# The key is NOT a secret (it ships inside the widget script tag) — real
# protection comes from the origin allowlist, rate limits and keeping
# provider keys server-side. Requiring it stops random websites from
# calling your API.
WIDGET_PUBLIC_KEY=
WIDGET_REQUIRE_KEY=True

# Comma separated origins that are allowed to embed the widget (fallback).
WIDGET_ALLOWED_ORIGINS=

# Per-visitor rate limits.
WIDGET_RATE=30/minute
WIDGET_EVENTS_RATE=120/minute
WIDGET_FEEDBACK_RATE=60/minute

# Max concurrent LLM calls per process; excess requests get a 429 + Retry-After.
RAG_MAX_CONCURRENT=8
# Cache identical first questions for this many seconds (big win on FAQ peaks).
RAG_RESPONSE_CACHE_SECONDS=60

# ─── Database (leave DB_NAME empty for local SQLite) ──────────────────────
# Production: PostgreSQL is strongly recommended for 200+ concurrent users.
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5432
DB_CONN_MAX_AGE=60

# ─── Cache ────────────────────────────────────────────────────────────────
# Production: use Redis so rate limiting and the answer cache are shared
# across all gunicorn workers.
CACHE_BACKEND=django.core.cache.backends.locmem.LocMemCache
CACHE_LOCATION=ai-support-cache
CACHE_TIMEOUT=300
# CACHE_BACKEND=django.core.cache.backends.redis.RedisCache
# CACHE_LOCATION=redis://127.0.0.1:6379/10

# ─── CORS (browser access control for the widget's API calls) ─────────────
# Production: keep CORS_ALLOW_ALL off. Origins added in the admin panel are
# applied to CORS automatically, so this env list is also just a fallback.
CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOWED_ORIGINS=

# ─── Reverse proxy / TLS ──────────────────────────────────────────────────
# True when behind nginx/caddy that terminates TLS and overwrites these headers.
TRUST_PROXY_SSL=True
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
# True only when nginx is configured to overwrite X-Forwarded-For.
TRUST_X_FORWARDED_FOR=True

# ─── Mail (optional; used for admin notifications) ────────────────────────
MAIL_BACKEND=
MAIL_HOST=localhost
MAIL_PORT=25
MAIL_USER=
MAIL_PASSWORD=
MAIL_USE_TLS=False
