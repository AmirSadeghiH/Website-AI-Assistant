# ─── Core Django ───────────────────────────────────────────────────────────
# In production DEBUG must be False. SECRET_KEY is REQUIRED in production;
# generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
DEBUG=False
SECRET_KEY=replace-with-a-long-random-value

# Comma separated hostnames that may serve this app.
ALLOWED_HOSTS=api.example.com,127.0.0.1,localhost

# ─── LLM provider (fallback values; editable later from the admin panel) ──
LLM_API_KEY=your-llm-api-key
LLM_BASE_URL=https://api.gapgpt.app/v1
LLM_MODEL=deepseek-v4-pro
LLM_MAX_TOKENS=700
LLM_TIMEOUT_SECONDS=30
# Keep 0 for predictable interactive latency; the widget retries on timeout.
LLM_MAX_RETRIES=0

# ─── Embedding provider (fallback values; editable from the admin panel) ──
EMBEDDING_API_KEY=your-embedding-api-key
EMBEDDING_BASE_URL=https://api.gapgpt.app/v1
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_TIMEOUT_SECONDS=15
EMBEDDING_MAX_RETRIES=0

# ─── Widget installation / access control ─────────────────────────────────
# These two values are only the FALLBACK. The same settings can be managed
# per customer from the admin panel (AI provider settings → نصب ویجت و
# کنترل دسترسی), which also applies them to CORS.
WIDGET_PUBLIC_KEY=
WIDGET_REQUIRE_KEY=True

# Comma separated origins that are allowed to embed the widget (fallback).
WIDGET_ALLOWED_ORIGINS=

# Per-visitor rate limits.
WIDGET_RATE=30/minute
WIDGET_EVENTS_RATE=120/minute

# Max concurrent LLM calls per process; excess requests get a 429 + Retry-After.
RAG_MAX_CONCURRENT=8
# Cache identical first questions for this many seconds.
RAG_RESPONSE_CACHE_SECONDS=60

# ─── Database (leave DB_NAME empty for local SQLite) ──────────────────────
# Production: PostgreSQL is strongly recommended.
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5432
DB_CONN_MAX_AGE=60

# ─── Cache (Redis in production, LocMem in dev) ───────────────────────────
# Production: set REDIS_URL for cross-worker rate limiting and answer caching.
# Leave empty for local development (LocMem backend used automatically).
REDIS_URL=
# CACHE_TIMEOUT=300

# ─── CORS (browser access control for the widget's API calls) ─────────────
# Production: keep CORS_ALLOW_ALL off. Origins in the admin panel are
# applied to CORS automatically.
CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOWED_ORIGINS=

# ─── Reverse proxy / TLS ──────────────────────────────────────────────────
TRUST_PROXY_SSL=True
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
TRUST_X_FORWARDED_FOR=True

# ─── Mail (optional; used for admin notifications) ────────────────────────
MAIL_BACKEND=
MAIL_HOST=localhost
MAIL_PORT=25
MAIL_USER=
MAIL_PASSWORD=
MAIL_USE_TLS=False

# ─── Monitoring thresholds ────────────────────────────────────────────────
# Errors per minute that trigger an admin notification.
MONITORING_ERROR_THRESHOLD=10
# Average latency (ms) that triggers a pressure notification.
MONITORING_LATENCY_THRESHOLD_MS=5000
