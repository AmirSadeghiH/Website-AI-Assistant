DEBUG=True

SECRET_KEY=your-secret-key

LLM_API_KEY=your-api-key

MODEL = model-name

OPENAI_API_KEY=api-key

EMBEDDING_API_KEY=your-api-key

BASE_URL="https://api.gapgpt.app/v1"
LLM_MODEL=deepseek-v4-pro
LLM_MAX_RETRIES=0

LLM_TIMEOUT_SECONDS=30
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_MAX_RETRIES=0
EMBEDDING_TIMEOUT_SECONDS=15

# Public installation controls. In production set a random value and require
# the matching data-widget-key on the embed script.
WIDGET_PUBLIC_KEY=
WIDGET_REQUIRE_KEY=False
WIDGET_ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
WIDGET_RATE=30/minute
WIDGET_EVENTS_RATE=120/minute
WIDGET_FEEDBACK_RATE=60/minute
RAG_MAX_CONCURRENT=8
RAG_RESPONSE_CACHE_SECONDS=60

# Optional PostgreSQL configuration. Leave DB_NAME empty for local SQLite.
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5432
DB_CONN_MAX_AGE=60

CACHE_BACKEND=django.core.cache.backends.locmem.LocMemCache
CACHE_LOCATION=ai-support-cache
CACHE_TIMEOUT=300
# Production shared cache:
# CACHE_BACKEND=django.core.cache.backends.redis.RedisCache
# CACHE_LOCATION=redis://127.0.0.1:6379/10

ALLOWED_HOSTS=127.0.0.1,localhost

# For local development only. In production prefer explicit origins below.
CORS_ALLOW_ALL_ORIGINS=True
CORS_ALLOWED_ORIGINS=

TRUST_PROXY_SSL=False
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=0
